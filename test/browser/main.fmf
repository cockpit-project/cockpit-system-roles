summary:
    Run browser integration tests on the host
require:
  - podman
  - cockpit-system-roles
  - cockpit-ws
  - cockpit-system
test: ./browser.sh
duration: 60m

adjust:
  - when: distro ~ centos
    require+:
      - rhel-system-roles

  - when: distro !~ centos
    require+:
      - linux-system-roles

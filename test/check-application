import testlib


@testlib.nondestructive
class TestSystemRoles(testlib.MachineCase):

    def testBasic(self) -> None:
        b = self.browser

        self.login_and_go("/system-roles")

        b.wait_in_text("body", "Manage your system with Ansible and System Roles")
        b.assert_pixels("h2", "header")


if __name__ == '__main__':
    testlib.test_main()
